{
  "manifest_version": 3,
  "name": "My MultiView",
  "version": "1.0.0",
  "description": "여러 치지직(CHZZK) 방송을 한 화면에서 동시에 시청할 수 있는 개인용 멀티뷰 도구",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "My MultiView"
  },
  "permissions": [
    "tabs",
    "storage",
    "cookies",
    "notifications",
    "alarms",
    "contentSettings",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://chzzk.naver.com/*",
    "https://api.chzzk.naver.com/*",
    "https://comm-api.game.naver.com/*",
    "https://game.naver.com/*",
    "https://nid.naver.com/*",
    "https://*.naver.com/*",
    "https://naver.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chzzk.naver.com/*"
      ],
      "exclude_matches": [
        "https://chzzk.naver.com/live/*/chat*"
      ],
      "js": [
        "content/watch-guard-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://chzzk.naver.com/*"
      ],
      "exclude_matches": [
        "https://chzzk.naver.com/live/*/chat*"
      ],
      "js": [
        "content/lp-external.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://chzzk.naver.com/live/*"
      ],
      "exclude_matches": [
        "https://chzzk.naver.com/live/*/chat*"
      ],
      "js": [
        "content/tile-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://chzzk.naver.com/live/*"
      ],
      "exclude_matches": [
        "https://chzzk.naver.com/live/*/chat*"
      ],
      "js": [
        "content/tile.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://chzzk.naver.com/live/*"
      ],
      "js": [
        "content/chat.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://chzzk.naver.com/live/*"
      ],
      "js": [
        "content/chat-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://chzzk.naver.com/live/*"
      ],
      "js": [
        "content/blind-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://chzzk.naver.com/live/*"
      ],
      "exclude_matches": [
        "https://chzzk.naver.com/live/*/chat*"
      ],
      "js": [
        "content/standalone-flags.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://chzzk.naver.com/live/*"
      ],
      "exclude_matches": [
        "https://chzzk.naver.com/live/*/chat*"
      ],
      "js": [
        "content/standalone-blind.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://chzzk.naver.com/live/*"
      ],
      "exclude_matches": [
        "https://chzzk.naver.com/live/*/chat*"
      ],
      "js": [
        "content/standalone-chat-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://chzzk.naver.com/live/*"
      ],
      "exclude_matches": [
        "https://chzzk.naver.com/live/*/chat*"
      ],
      "js": [
        "content/standalone-ad.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://chzzk.naver.com/live/*"
      ],
      "exclude_matches": [
        "https://chzzk.naver.com/live/*/chat*"
      ],
      "js": [
        "content/standalone-chat.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}